# docker-compose.yml（本番）用の設定サンプル
#
#   cp .env.docker.sample .env.docker
#   docker compose --env-file .env.docker up -d
#
# 開発用の .env とは別ファイルにしている（.env は $HOME 込みのパスを含むため
# compose からは使えない）。

# === ホスト側のディレクトリ ===================================================
# コンテナは uid=gid=1000（phantom / node）で動くので、書き込み先の
# PHANTOM_DATA_DIR は 1000 が書けるようにしておく:
#   sudo install -d -o 1000 -g 1000 /var/lib/phantom/data
#
# インターネット出願ソフトの電子データ（navi が読む。read-only でマウント）
PHANTOM_SRC_DIR=/mnt/disk/jpodata/src

# XML が無く HTML + 画像しか残っていない文書（navi が読む。read-only でマウント）
# 未設定なら PHANTOM_SRC_DIR を見る
PHANTOM_HTML_SRC_DIR=/mnt/disk/jpodata/html-src

# 文書ストア。navi が書き、mona・queen が読む
PHANTOM_DATA_DIR=/var/lib/phantom/data

# === 公開ポート ===============================================================
# ホストに出るのは nginx のこのポートだけ。各サービスは phantom-network 内のみ
#   /              joker（検索 UI）
#   /fox/          fox（文書ビューア）
#   /skull/        skull（メタ情報管理）
#   /navi/         navi（取り込みの管理）
#   /api/contents/ mona（文書コンテンツ）
PHANTOM_HTTP_PORT=8080

# ブラウザから見える phantom のベース URL（joker → fox のリンク生成に使う）
PHANTOM_PUBLIC_URL=http://localhost:8080

# === 共通 =====================================================================
PHANTOM_TZ=Asia/Tokyo
LOG_LEVEL=INFO

# === Elasticsearch ============================================================
# コンテナ間は http://es:9200 固定。ここでは認証とリソースだけ指定する
ES_USER=elastic
ES_PASSWORD=changeme
# ES_API_KEY=
ES_DOC_INDEX=documents
ES_IMG_INDEX=images
ES_JAVA_OPTS=-Xms2g -Xmx2g

# === メモリ上限 ===============================================================
# 各コンテナの mem_limit（memswap_limit も同じ値になり、スワップを使わなくなる）。
# 上限を超えたコンテナは OOM kill されて再起動する。ホストがスワップの
# 取り合いで固まるのを防ぐための設定なので、外さないこと。
#
# 既定値は「モデルのロード時ピーク + 余裕」。常駐量で決めると、重みが一瞬だけ
# 二重に乗るロードの最中に OOM kill される（queen の CLIP は常駐 2.7GB／ピーク 4.0GB）。
# 上限の合計は約 14GB になるが、これは「そこまで使ったら殺す」という天井であって
# 実使用ではない。実測のピークは約 7.5GB（推奨メモリ 16GB）。
# 8GB のホストに載せる場合は ES_JAVA_OPTS=-Xms1g -Xmx1g / ES_MEM_LIMIT=2g にする。
# ただし queen はどう削っても 4.5g を切ると CLIP を読めない。
ES_MEM_LIMIT=4g
# QUEEN_MEM_LIMIT=6g     # ruri 0.7GB ＋ CLIP（ロードに 4.0GB、読み終えると 2.7GB 常駐）
# FOX_MEM_LIMIT=512m
# JOKER_MEM_LIMIT=512m
# SKULL_MEM_LIMIT=512m
# MONA_MEM_LIMIT=256m
# NAVI_MEM_LIMIT=2g        # 取り込みの XSLT（saxonche がプロセス内に JVM を持つ）と画像変換のワーカー。
#                          # XSLT を別のサービスでしていたころ、1g では OOM kill された（2026-08-20）
# NGINX_MEM_LIMIT=128m

# === queen ==================================================================
# モデルの設定は queen が読む（テキスト側の変数名は noir にあったときのまま）
# NOIR_EMBEDDING_PROVIDER=sentence-transformers
# NOIR_EMBEDDING_MODEL=cl-nagoya/ruri-v3-130m
# NOIR_EMBEDDING_DEVICE=cpu
# EMBEDDING_DEVICE=cpu
# QUEEN_TORCH_THREADS=0
# QUEEN_PRELOAD=1
# Hugging Face に問い合わせずにキャッシュから読む。キャッシュにモデルがあるのに
# Hugging Face に繋がらず、queen の起動が終わらないときだけ 1 にする
# HF_HUB_OFFLINE=1

# === navi =====================================================================
# OCR_LANG=jpn+eng
# 並列度（設計書 §2.4）
# NAVI_DOC_CONCURRENCY=4
# NAVI_OCR_SLOTS=4
# NAVI_IMAGE_WORKERS=4
