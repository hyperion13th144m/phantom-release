# === crow =====================================================
# スキャン対象ディレクトリ（インターネット出願ソフトの電子データがある場所）
SRC_DIR=/path/to/src

# 展開先ディレクトリ（文書IDで階層化して保存される）
DST_DIR=/path/to/data

# タスク状態（進捗・履歴）の保存先
CROW_STATE_DIR=/var/lib/crow/tasks

# ログレベル: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# APIサーバのバインド先
# 他サービスと環境変数がぶつからないよう CROW_ プレフィックスを付ける
CROW_HOST=0.0.0.0
CROW_PORT=8000

QUEEN_HOST=0.0.0.0
QUEEN_PORT=8001
# QUEEN_STATE_DIR=/var/lib/queen/tasks

# 画像変換に使うプロセス数。省略時は「論理コア数 - 1」。
# 1 にすると並列化せず queen 自身のプロセスで変換する
# QUEEN_IMAGE_WORKERS=4

# mona は DST_DIR と LOG_LEVEL を crow/queen と共用する
MONA_HOST=0.0.0.0
MONA_PORT=8002

# violet は DST_DIR と LOG_LEVEL を crow/queen と共用する
VIOLET_HOST=0.0.0.0
VIOLET_PORT=8003
# VIOLET_STATE_DIR=/var/lib/violet/tasks
# OCR_LANG=jpn+eng
# EMBEDDING_DEVICE=cpu

# OCR とエンベディングに使うプロセス数。省略時は「論理コア数 - 1」を上限4で頭打ち。
# ワーカー1つにつき CLIP の画像タワーが 0.8GB 常駐する。1 にすると並列化しない
# VIOLET_IMAGE_WORKERS=4

# noir は DST_DIR と LOG_LEVEL を crow/queen と共用する
NOIR_HOST=0.0.0.0
NOIR_PORT=8004
# NOIR_STATE_DIR=/var/lib/noir/tasks

# テキストエンベディング: sentence-transformers（既定） | local（テスト用 char-ngram）
# NOIR_EMBEDDING_PROVIDER=sentence-transformers
# NOIR_EMBEDDING_MODEL=cl-nagoya/ruri-v3-130m
# NOIR_EMBEDDING_DEVICE=cpu
# モデルを変える場合はプレフィックスも合わせる（例: multilingual-e5 系は "passage: " / "query: "）
# 末尾の半角スペースまでが値なので引用符付きで指定する
# NOIR_EMBEDDING_DOC_PREFIX="検索文書: "
# NOIR_EMBEDDING_QUERY_PREFIX="検索クエリ: "

# 1文書あたりのトークン数の上限。0 でモデルの既定（ruri-v3 は 8192）のまま。
# 既定の 1024 は 8192 の 2.1 倍速く、ベクトルのコサインは 0.994
# 変えたら document-properties.json を消して再実行し、ES にも入れ直すこと
# NOIR_EMBEDDING_MAX_SEQ_LENGTH=1024

# === cendrillon =====================================================
# XML が無く HTML + 画像しか残っていない文書の取り込み先ディレクトリ
CENDRILLON_SRC_DIR=/path/to/html-src

# cendrillon は DST_DIR と LOG_LEVEL を crow/queen と共用する
CENDRILLON_HOST=0.0.0.0
CENDRILLON_PORT=8008
# CENDRILLON_STATE_DIR=/var/lib/cendrillon/tasks

# cendrillon はモデルを持たず、テキストエンベディングを noir に、
# 画像エンベディングと OCR を violet に投げる（URL は navi / joker と共用）。
# 画像は本体を送らず在り処だけを送るので、violet と同じ DST_DIR が見えていること
# NOIR_URL=http://localhost:8004
# VIOLET_URL=http://localhost:8003
# 1リクエストのタイムアウト（秒）。いちばん遅いのは OCR で 2.4 秒/枚
# CENDRILLON_ENRICH_TIMEOUT=120

# === panther ==================================================
# panther は DST_DIR と LOG_LEVEL を crow/queen と共用する
PANTHER_HOST=0.0.0.0
PANTHER_PORT=8006
# PANTHER_STATE_DIR=/var/lib/panther/tasks

# Elasticsearch への接続。ES_API_KEY 指定時は Basic 認証より優先される
ES_URL=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=changeme
# ES_API_KEY=
# ES_DOC_INDEX=documents
# ES_IMG_INDEX=images
# インデックス自動作成に使うマッピングファイル（infra/es）の場所
ES_MAPPING_DIR=/path/to/phantom/infra/es

# === navi =====================================================
# パイプライン管制サービス。各サービスのURLは既定でローカルの既定ポートを見る
NAVI_HOST=0.0.0.0
NAVI_PORT=8005
# CROW_URL=http://localhost:8000
# QUEEN_URL=http://localhost:8001
# NOIR_URL=http://localhost:8004
# VIOLET_URL=http://localhost:8003
# CENDRILLON_URL=http://localhost:8008
# PANTHER_URL=http://localhost:8006
# FOX_URL=http://localhost:4321
# パイプライン実行中のポーリング間隔（秒）
# NAVI_POLL_INTERVAL=2.0

# === fox ======================================================
# mona のベース URL（MONA_PORT に合わせる）
MONA_URL=http://localhost:8002

# fox サーバのバインド先
FOX_HOST=0.0.0.0
FOX_PORT=4321

# 表示設定の保存先（省略時は $REPO_ROOT/var/config/fox.config）
#FOX_CONFIG_PATH=/path/to/fox.config

# ログ出力先（書き込み不可の場合は stdout にフォールバック）
#LOG_DIR_FOX=/var/log/fox

# === joker ====================================================
# joker は Elasticsearch 接続（ES_URL / ES_USER / ES_PASSWORD / ES_API_KEY /
# ES_DOC_INDEX / ES_IMG_INDEX）を panther と、MONA_URL を fox と共用する

# joker サーバのバインド先
JOKER_HOST=0.0.0.0
JOKER_PORT=4322

# セマンティック検索のクエリ変換に使う noir のベース URL（NOIR_PORT に合わせる）
# NOIR_URL=http://localhost:8004

# 画像のセマンティック検索でフレーズを CLIP ベクトルに変換する violet のベース URL
# VIOLET_URL=http://localhost:8003

# トップページの「管理画面」リンク先。既定は相対パスの /navi で、
# リバースプロキシ配下（本番）ではこれで navi に届く。
# dev は joker と navi が別ポートなので NAVI_PORT に合わせて上書きする
# NAVI_URL=http://localhost:8005

# === skull ====================================================
# skull は Elasticsearch 接続（ES_URL / ES_USER / ES_PASSWORD / ES_API_KEY /
# ES_DOC_INDEX / ES_IMG_INDEX）と LOG_LEVEL を panther と共用する

# skull サーバのバインド先
SKULL_HOST=0.0.0.0
SKULL_PORT=8007

# メタ情報 DB（SQLAlchemy URL）。PostgreSQL なら postgresql+psycopg://user:pass@host/db
SKULL_DB_URL=sqlite:////var/lib/skull/skull.db
# SKULL_STATE_DIR=/var/lib/skull/tasks

# navi から skull を監視するときのベース URL（SKULL_PORT に合わせる）
# SKULL_URL=http://localhost:8007
# JOKER_URL=http://localhost:4322

# 検索結果からリンクする fox のベース URL（FOX_PORT に合わせる）
# FOX_URL=http://localhost:4321

# ログ出力先（書き込み不可の場合は stdout にフォールバック）
#LOG_DIR_JOKER=/var/log/joker
