# === 置き場所（navi の取り込み・mona・queen が使う）=====================
# 元データ（インターネット出願ソフトの電子データがある場所）。下を再帰的にたどる
SRC_DIR=/path/to/src
# XML が無く HTML + 画像しか残っていない文書の元データ
CENDRILLON_SRC_DIR=/path/to/html-src

# 文書ストア（文書IDで階層化して保存される）
DST_DIR=/path/to/data

# 取り込む書類の対象表（infra/whitelist/README.md）。XML は書類コードで、
# HTML は書類名で照合する。未設定なら絞り込まず全部取り込む。
# docker ではイメージに焼いてあるので compose が /infra/whitelist を指す
WHITE_LIST_PATH=/path/to/phantom/infra/whitelist/white-list.json

# ログレベル: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# navi の実行の履歴（NAVI_STATE_DIR）・skull のタスク状態と DB の既定の置き場所。
# 未指定なら Linux は /var/lib/<サービス>、Windows は %LOCALAPPDATA%\phantom\<サービス>。
# 個別の NAVI_STATE_DIR / SKULL_STATE_DIR / SKULL_DB_URL を指定すればそちらが優先する
# PHANTOM_HOME=/path/to/phantom/var/lib

# === mona =====================================================
MONA_HOST=0.0.0.0
MONA_PORT=8002

# === queen（モデルサーバー）===========================================
# ruri（文書・クエリ）と CLIP（画像・テキスト）を常駐させる。navi の取り込みと joker の検索が使う。
# 画像は {docId, filename} で受け取って DST_DIR から読む
QUEEN_HOST=0.0.0.0
QUEEN_PORT=8001
# 呼ぶ側（navi・joker）が使う URL
# QUEEN_URL=http://localhost:8001
# torch のスレッド数。0 で torch の既定（物理コア数）。OCR と同じ機械でも 0 のままでよい（設計書 §2.4）
# QUEEN_TORCH_THREADS=0
# 起動したら裏でモデルを読み始める。0 で最初の依頼のときに読む
# QUEEN_PRELOAD=1
# CLIP のデバイス
# EMBEDDING_DEVICE=cpu

# テキストエンベディング（queen が読む。変数名は noir にあったときのまま）:
# sentence-transformers（既定） | local（テスト用 char-ngram）
# NOIR_EMBEDDING_PROVIDER=sentence-transformers
# NOIR_EMBEDDING_MODEL=cl-nagoya/ruri-v3-130m
# NOIR_EMBEDDING_DEVICE=cpu
# モデルを変える場合はプレフィックスも合わせる（例: multilingual-e5 系は "passage: " / "query: "）
# 末尾の半角スペースまでが値なので引用符付きで指定する
# NOIR_EMBEDDING_DOC_PREFIX="検索文書: "
# NOIR_EMBEDDING_QUERY_PREFIX="検索クエリ: "

# 1文書あたりのトークン数の上限。0 でモデルの既定（ruri-v3 は 8192）のまま。
# 既定の 1024 は 8192 の 2.1 倍速く、ベクトルのコサインは 0.994
# 変えたら document-properties.json を消して再実行し、ES にも入れ直すこと
# NOIR_EMBEDDING_MAX_SEQ_LENGTH=1024

# === Elasticsearch（navi・joker・skull が使う）===========================
# ES_API_KEY 指定時は Basic 認証より優先される
ES_URL=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=changeme
# ES_API_KEY=
# ES_DOC_INDEX=documents
# ES_IMG_INDEX=images
# インデックスが無いときに navi がこのマッピングで作る（infra/es）。リポジトリから起動すれば自動で見つかる
# ES_MAPPING_DIR=/path/to/phantom/infra/es

# === navi（取り込みと、その管理画面）====================================
NAVI_HOST=0.0.0.0
NAVI_PORT=8005
# OCR（tesseract）の言語。tesseract の実行ファイルは未指定なら PATH から探す（Windows では指定が必要）
# OCR_LANG=jpn+eng
# TESSERACT_CMD=/usr/bin/tesseract
# XSL（libs/jpo-schema/stylesheets/2.0）。リポジトリから起動すれば自動で見つかる
# XSL_DIR=/path/to/phantom/libs/jpo-schema/stylesheets/2.0
# 並列度（設計書 §2.4）: 同時に処理する文書の数・同時に動かす OCR の数・画像変換のプロセス数
# NAVI_DOC_CONCURRENCY=4
# NAVI_OCR_SLOTS=4
# NAVI_IMAGE_WORKERS=4
# queen への1リクエスト・tesseract の1枚のタイムアウト（秒）
# NAVI_QUEEN_TIMEOUT=300
# NAVI_OCR_TIMEOUT=120
# 実行の最初に Elasticsearch に繋がるまで待つ上限（秒）。0 なら待たない
# NAVI_ES_WAIT_TIMEOUT=60
# 実行の履歴の置き場所（省略時は PHANTOM_HOME の下）
# NAVI_STATE_DIR=/var/lib/navi
# navi が health を監視するサービス
# FOX_URL=http://localhost:4321

# === fox ======================================================
# mona のベース URL（MONA_PORT に合わせる）
MONA_URL=http://localhost:8002

# fox サーバのバインド先
FOX_HOST=0.0.0.0
FOX_PORT=4321

# 表示設定の保存先（省略時は $REPO_ROOT/var/config/fox.config）
#FOX_CONFIG_PATH=/path/to/fox.config

# ログ出力先（書き込み不可の場合は stdout にフォールバック）
#LOG_DIR_FOX=/var/log/fox

# === joker ====================================================
# joker は Elasticsearch 接続（ES_URL / ES_USER / ES_PASSWORD / ES_API_KEY /
# ES_DOC_INDEX / ES_IMG_INDEX）を navi と、MONA_URL を fox と共用する

# joker サーバのバインド先
JOKER_HOST=0.0.0.0
JOKER_PORT=4322

# セマンティック検索のクエリ変換に使う queen のベース URL（QUEEN_PORT に合わせる）。
# 文書は /noir/embeddings/query（ruri）、画像は /violet/embeddings/query（CLIP）
# QUEEN_URL=http://localhost:8001

# トップページの「管理画面」リンク先。既定は相対パスの /navi で、
# リバースプロキシ配下（本番）ではこれで navi に届く。
# dev は joker と navi が別ポートなので NAVI_PORT に合わせて上書きする
# NAVI_URL=http://localhost:8005

# === skull ====================================================
# skull は Elasticsearch 接続（ES_URL / ES_USER / ES_PASSWORD / ES_API_KEY /
# ES_DOC_INDEX / ES_IMG_INDEX）と LOG_LEVEL を navi と共用する

# skull サーバのバインド先
SKULL_HOST=0.0.0.0
SKULL_PORT=8007

# メタ情報 DB（SQLAlchemy URL）。PostgreSQL なら postgresql+psycopg://user:pass@host/db
SKULL_DB_URL=sqlite:////var/lib/skull/skull.db
# SKULL_STATE_DIR=/var/lib/skull/tasks

# navi から skull を監視するときのベース URL（SKULL_PORT に合わせる）
# SKULL_URL=http://localhost:8007
# JOKER_URL=http://localhost:4322

# 検索結果からリンクする fox のベース URL（FOX_PORT に合わせる）
# FOX_URL=http://localhost:4321

# ログ出力先（書き込み不可の場合は stdout にフォールバック）
#LOG_DIR_JOKER=/var/log/joker
