{
    "settings": {
        "analysis": {
            "char_filter": {
                "normalize": {
                    "type": "icu_normalizer",
                    "name": "nfkc",
                    "mode": "compose"
                }
            },
            "tokenizer": {
                "ngram_2_tokenizer": {
                    "type": "ngram",
                    "min_gram": "2",
                    "max_gram": "2",
                    "token_chars": ["letter", "digit"]
                }
            },
            "analyzer": {
                "ja_kuromoji": {
                    "type": "custom",
                    "char_filter": ["normalize"],
                    "tokenizer": "kuromoji_tokenizer",
                    "filter": [
                        "kuromoji_baseform",
                        "kuromoji_part_of_speech",
                        "ja_stop",
                        "kuromoji_stemmer",
                        "lowercase"
                    ]
                },
                "ja_ngram": {
                    "type": "custom",
                    "char_filter": ["normalize"],
                    "tokenizer": "ngram_2_tokenizer",
                    "filter": ["lowercase"]
                }
            }
        }
    },
    "mappings": {
        "properties": {
            "docId": { "type": "keyword" },

            "task": { "type": "keyword" },
            "kind": { "type": "keyword" },
            "extension": { "type": "keyword" },

            "law": { "type": "keyword" },
            "documentName": { "type": "keyword" },
            "documentCode": { "type": "keyword" },
            "applicationNumber": {
                "type": "keyword",
                "fields": {
                    "ngram": { "type": "text", "analyzer": "ja_ngram" }
                }
            },
            "registrationNumber": {
                "type": "keyword",
                "fields": {
                    "ngram": { "type": "text", "analyzer": "ja_ngram" }
                }
            },
            "internationalApplicationNumber": {
