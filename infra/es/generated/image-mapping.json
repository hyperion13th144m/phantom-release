{
    "settings": {
        "analysis": {
            "char_filter": {
                "normalize": {
                    "type": "icu_normalizer",
                    "name": "nfkc",
                    "mode": "compose"
                }
            },
            "tokenizer": {
                "my_ngram_tokenizer": {
                    "type": "ngram",
                    "min_gram": "2",
                    "max_gram": "2",
                    "token_chars": [
                        "letter",
                        "digit"
                    ]
                }
            },
            "analyzer": {
                "my_kuromoji_analyzer": {
                    "type": "custom",
                    "char_filter": [
                        "normalize"
                    ],
                    "tokenizer": "kuromoji_tokenizer",
                    "filter": [
                        "kuromoji_baseform",
                        "kuromoji_part_of_speech",
                        "ja_stop",
                        "kuromoji_stemmer",
                        "lowercase"
                    ]
                },
                "my_ngram_analyzer": {
                    "type": "custom",
                    "char_filter": [
                        "normalize"
                    ],
                    "tokenizer": "my_ngram_tokenizer",
                    "filter": [
                        "lowercase"
                    ]
                }
            }
        }
    },
    "mappings": {
        "properties": {
            "imageId": {
                "type": "keyword"
            },
            "docId": {
                "type": "keyword"
            },
            "kind": {
                "type": "keyword"
            },
            "figureNumber": {
                "type": "keyword",
                "fields": {
                    "ngram": {
                        "type": "text",
                        "analyzer": "my_ngram_analyzer"
                    }
                }
            },
            "sourceFilename": {
                "type": "keyword"
            },
            "thumbnailFilename": {
                "type": "keyword"
            },
            "middleFilename": {
                "type": "keyword"
            },
            "largeFilename": {
                "type": "keyword"
            },
            "description": {
                "type": "text",
                "analyzer": "my_kuromoji_analyzer",
                "fields": {
                    "ngram": {
                        "type": "text",
                        "analyzer": "my_ngram_analyzer"
                    }
                }
            },
            "captionText": {
                "type": "text",
                "analyzer": "my_kuromoji_analyzer",
                "fields": {
                    "ngram": {
                        "type": "text",
                        "analyzer": "my_ngram_analyzer"
                    }
                }
            },
            "ocrText": {
                "type": "text",
                "analyzer": "my_kuromoji_analyzer",
                "fields": {
                    "ngram": {
                        "type": "text",
                        "analyzer": "my_ngram_analyzer"
                    }
                }
            },
            "representative": {
                "type": "boolean"
            },
            "directMentionText": {
                "type": "text",
                "analyzer": "my_kuromoji_analyzer",
                "fields": {
                    "ngram": {
                        "type": "text",
                        "analyzer": "my_ngram_analyzer"
                    }
                }
            },
            "sectionText": {
                "type": "text",
                "analyzer": "my_kuromoji_analyzer",
                "fields": {
                    "ngram": {
                        "type": "text",
                        "analyzer": "my_ngram_analyzer"
                    }
                }
            },
            "weakContextText": {
                "type": "text",
                "analyzer": "my_kuromoji_analyzer",
                "fields": {
                    "ngram": {
                        "type": "text",
                        "analyzer": "my_ngram_analyzer"
                    }
                }
            },
            "linkingConfidence": {
                "type": "keyword"
            },
            "autoTags": {
                "type": "keyword",
                "fields": {
                    "ngram": {
                        "type": "text",
                        "analyzer": "my_ngram_analyzer"
                    }
                }
            },
            "manualTags": {
                "type": "keyword",
                "fields": {
                    "ngram": {
                        "type": "text",
                        "analyzer": "my_ngram_analyzer"
                    }
                }
            },
            "tags": {
                "type": "keyword",
                "fields": {
                    "ngram": {
                        "type": "text",
                        "analyzer": "my_ngram_analyzer"
                    }
                }
            },
            "embeddingModel": {
                "type": "keyword"
            },
            "embeddingVersion": {
                "type": "keyword"
            },
            "embeddingDimensions": {
                "type": "integer"
            },
            "embeddingGeneratedAt": {
                "type": "date"
            },
            "embeddingImageFilename": {
                "type": "keyword"
            },
            "embeddingImageHash": {
                "type": "keyword"
            },
            "embeddingTextHash": {
                "type": "keyword"
            },
            "imageEmbedding": {
                "type": "dense_vector",
                "dims": 512,
                "index": true,
                "similarity": "cosine"
            },
            "contextEmbedding": {
                "type": "dense_vector",
                "dims": 512,
                "index": true,
                "similarity": "cosine"
            },
            "bibliographic": {
                "type": "object",
                "properties": {
                    "applicationNumber": {
                        "type": "keyword",
                        "fields": {
                            "ngram": {
                                "type": "text",
                                "analyzer": "my_ngram_analyzer"
                            }
                        }
                    },
                    "internationalApplicationNumber": {
                        "type": "keyword",
                        "fields": {
                            "ngram": {
                                "type": "text",
                                "analyzer": "my_ngram_analyzer"
                            }
                        }
                    },
                    "registrationNumber": {
                        "type": "keyword",
                        "fields": {
                            "ngram": {
                                "type": "text",
                                "analyzer": "my_ngram_analyzer"
                            }
                        }
                    },
                    "fileReferenceId": {
                        "type": "keyword",
                        "fields": {
                            "ngram": {
                                "type": "text",
                                "analyzer": "my_ngram_analyzer"
                            }
                        }
                    },
                    "documentName": {
                        "type": "keyword"
                    },
                    "documentCode": {
                        "type": "keyword"
                    },
                    "applicants": {
                        "type": "keyword",
                        "fields": {
                            "ngram": {
                                "type": "text",
                                "analyzer": "my_ngram_analyzer"
                            }
                        }
                    },
                    "inventors": {
                        "type": "keyword",
                        "fields": {
                            "ngram": {
                                "type": "text",
                                "analyzer": "my_ngram_analyzer"
                            }
                        }
                    },
                    "inventionTitle": {
                        "type": "text",
                        "analyzer": "my_kuromoji_analyzer",
                        "fields": {
                            "ngram": {
                                "type": "text",
                                "analyzer": "my_ngram_analyzer"
                            }
                        }
                    },
                    "datetime": {
                        "type": "date",
                        "format": "epoch_millis"
                    }
                }
            },
            "ingest_hash": {
                "type": "keyword"
            },
            "ingested_at": {
                "type": "date"
            }
        }
    }
}
